	if Utils.character.get_trust() <= -5 or Utils.ctx["is_suspicious"]
		Silvia: Presenting heavy furniture items reflects severely degraded diagnostic focus.
		Silvia: You are reaching.
	elif Utils.character.get_trust() >= 5 or Utils.ctx["evidence_focus"] >= 8
